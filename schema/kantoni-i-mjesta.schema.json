{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/azra212/BiH_Gradovi_Mjesta/main/schema/kantoni-i-mjesta.schema.json",
  "title": "BiH gradovi i mjesta",
  "description": "Struktura fajla 'kantoni i mjesta u BiH.json': entitet -> kanton/regija -> lista stavki {name, code}, plus lista država van BiH.",
  "type": "object",
  "required": ["Federacija BiH", "Republika Srpska", "Brčko Distrikt", "Van BiH"],
  "additionalProperties": false,
  "properties": {
    "Federacija BiH": { "$ref": "#/$defs/entity" },
    "Republika Srpska": { "$ref": "#/$defs/entity" },
    "Brčko Distrikt": { "$ref": "#/$defs/entity" },
    "Van BiH": {
      "type": "object",
      "required": ["Države"],
      "additionalProperties": false,
      "properties": {
        "Države": { "$ref": "#/$defs/items" }
      }
    }
  },
  "$defs": {
    "entity": {
      "description": "Kantoni (FBiH), regije (RS) ili distrikt (Brčko); ključ je naziv grupe.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/items" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    },
    "item": {
      "type": "object",
      "required": ["name", "code"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Naziv grada, općine ili države.",
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S(.*\\S)?$"
        },
        "code": {
          "description": "Kod iz izvorne liste (porijeklo nije dokumentovano). Prazan string znači da kod još nije dodijeljen.",
          "type": "string",
          "pattern": "^([0-9]+)?$"
        }
      }
    }
  }
}
